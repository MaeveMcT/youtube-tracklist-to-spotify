{
  "manifest_version": 3,
  "name": "YouTube Tracklist to Spotify",
  "version": "0.1.3",
  "description": "Detect timestamped DJ-set tracklists on YouTube and add the currently playing track to a Spotify playlist.",
  "permissions": ["storage", "identity", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_title": "YouTube Tracklist to Spotify",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-tracklist-to-spotify@extension.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "searchTerms", "websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
