{
  "manifest_version": 3,
  "name": "Tracklist → Spotify",
  "version": "0.1.3",
  "description": "Detect timestamped DJ-set tracklists on YouTube and add the currently playing track to a Spotify playlist.",
  "permissions": ["storage", "identity", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Tracklist → Spotify",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tracklist-to-spotify@openai.local",
      "strict_min_version": "121.0"
    }
  }
}
